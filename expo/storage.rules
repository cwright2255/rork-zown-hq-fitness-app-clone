rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/media/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Photos and videos on feed posts (see services/postMediaService.js).
    // The feed is public to signed-in users, so any signed-in user can read.
    // Only the owner can add or remove files, and every file must be a photo
    // under 15 MB or a video under 100 MB. Keep these sizes in sync with
    // MAX_PHOTO_BYTES and MAX_VIDEO_BYTES in lib/postMedia.js.
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // The try-on's garment files: the drape packs and the sizing files (see lib/tryOn/packStore.js and docs/TRYON_PACKS.md). Any signed-in person can read
    // them, because the app downloads them with the person's own sign-in token; nobody can write them from the app, so they are put here by the project's owner
    // (the Firebase console or gsutil, which are not held back by these rules). They are the project's own work and are kept out of the public repository.
    match /tryon-packs/{version}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
