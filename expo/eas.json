{
  "cli": {
    "version": ">= 10.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "install": {
        "command": "bun install"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      },
      "install": {
        "command": "bun install"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "install": {
        "command": "bun install"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "install": {
        "command": "bun install"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
