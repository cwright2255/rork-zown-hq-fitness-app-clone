rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // True when either of the two people has blocked the other: a document users/{uid}/blocks/{otherUid}, which only the person who
    // blocks can write (the blocks rule below). The rules for a conversation and for a message look for it, so two people cannot start
    // a conversation or send each other a message once either of them has blocked the other.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b)) ||
        exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    // The same for an existing conversation, looked up by its id.
    function conversationBlocked(conversationId) {
      let ids = get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      return blockedBetween(ids[0], ids[1]);
    }

    // The name and picture a person shows to other people on a post, a comment or a conversation: the name and profileImage on their own
    // users/{uid} document. services/publicProfile.js brings that document up to date just before the app writes one of those, so a
    // post, comment or conversation can only carry the name and picture on the person's profile, not one made up for the occasion.
    // A person whose profile has no name is shown as Zown User, and one with no picture has none.
    function publicName(uid) {
      let name = exists(/databases/$(database)/documents/users/$(uid)) ?
        get(/databases/$(database)/documents/users/$(uid)).data.get('name', '') : '';
      return (name is string && name.size() > 0) ? name : 'Zown User';
    }

    function publicImage(uid) {
      let image = exists(/databases/$(database)/documents/users/$(uid)) ?
        get(/databases/$(database)/documents/users/$(uid)).data.get('profileImage', null) : null;
      return (image is string && image.size() > 0) ? image : null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Written only by Cloud Functions. users/{uid}/stats/xp is the XP ledger (functions/src/xpLedger.js): the person's XP, level,
      // streak and distance, which they can read here and never write.
      match /stats/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // XP claims (services/xpClaims.js). The app no longer writes a score anywhere: it files a claim for what it earned ("a 5.2 km
      // run today"), and onXpClaim (functions/src/xpLedger.js, with the rules in lib/xpRules.js) checks it, works out the XP and
      // adds it to the ledger above. A claim can be created once and never changed or removed, so it cannot be sent again
      // under the same name, and the fields the function writes back (processedAt, result, amount, reason) cannot be put on a
      // new one. The numbers are only held to sensible limits here; the function does the real checking.
      match /xpClaims/{claimId} {
        function claimKeys() {
          return ['kind', 'day', 'baseExp', 'multiplier', 'distanceKm', 'durationSec', 'activity', 'foodKey', 'tier', 'steps', 'total', 'activeDays'];
        }

        function validClaim() {
          let d = request.resource.data;
          return d.keys().hasOnly(claimKeys()) && d.keys().hasAll(['kind', 'day']) &&
            d.kind in ['workout', 'run', 'hike', 'meal', 'plan', 'advice', 'formcheck', 'journey', 'race', 'hydration', 'steps', 'import'] &&
            d.day is string && d.day.matches('^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$') &&
            (!('baseExp' in d) || (d.baseExp is number && d.baseExp >= 0 && d.baseExp <= 10000)) &&
            (!('multiplier' in d) || (d.multiplier is number && d.multiplier >= 0 && d.multiplier <= 10)) &&
            (!('distanceKm' in d) || (d.distanceKm is number && d.distanceKm >= 0 && d.distanceKm <= 1000)) &&
            (!('durationSec' in d) || (d.durationSec is number && d.durationSec >= 0 && d.durationSec <= 1000000)) &&
            (!('activity' in d) || (d.activity is string && d.activity.size() <= 10)) &&
            (!('foodKey' in d) || (d.foodKey is string && d.foodKey.size() <= 80)) &&
            (!('tier' in d) || (d.tier is int && d.tier >= 0 && d.tier <= 5)) &&
            (!('steps' in d) || (d.steps is int && d.steps >= 0 && d.steps <= 100000)) &&
            (!('total' in d) || (d.total is number && d.total >= 0 && d.total <= 5000000)) &&
            (!('activeDays' in d) || (d.activeDays is list && d.activeDays.size() <= 400));
        }

        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId &&
          claimId.matches('^[A-Za-z0-9_-]+$') && claimId.size() <= 100 && validClaim();
        allow update, delete: if false;
      }

      // CRITICAL FIX: users/{uid}/data/{key} is used by SEVEN different
      // stores (badgeStore, expStore, healthStore, nutritionStore,
      // recipesStore, runningStore, settingsStore) and had NO rule covering
      // it at all. The top-level `match /users/{userId}` rule above does
      // NOT cascade to subcollections in Firestore — every one of these
      // stores has been silently denied on every read/write since this
      // path pattern was introduced, regardless of any application-level
      // code being correct. This is likely the single highest-impact fix
      // in this pass: it doesn't just fix new code, it retroactively fixes
      // sync for health data, XP, running stats, and settings that were
      // never flagged as broken because the failure was silent.
      match /data/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Three of these are the server's to write, not the person's: which achievements and badges are unlocked and which Battle
        // Pass tiers are claimed are decided in Cloud Functions (functions/src/unlocks.js, functions/src/unlockRules.js), which write
        // them with admin rights. The person can read them and cannot write them, so an unlock or a claim cannot be given by hand.
        allow write: if request.auth != null && request.auth.uid == userId &&
          !(docId in ['achievements', 'badges', 'battlePass']);
      }

      // NEW: form-check session history (services/formAnalysisService.js)
      match /formSessions/{sessionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false; // sessions are write-once; write a new doc instead of editing history
      }

      // NEW: body composition scan history (store/bodyCompositionStore.js).
      // Contains SMPL-X shape parameters and derived measurements — treat as
      // sensitive health data, same access pattern as everything else under
      // users/{userId}: owner-only, no cross-user reads.
      // NEW: saved recipes (store/recipeStore.js) — includes ones imported
      // via the share-to-app flow (app/recipes/import-from-share.jsx).
      // Unlike formSessions/bodyScans, recipes ARE mutable (favoriting,
      // manual edits), so update is allowed, not just create+read.
      match /recipes/{recipeId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // NEW: finished fasts (services/fastingService.js), one document per
      // fast, named by its start time. The running fast lives in
      // users/{uid}/data/fasting and is already covered by the data/{docId}
      // rule above; this is only the history behind the Fasting widget's
      // streak and charts. Owner-only; update is allowed because saving the
      // same fast twice writes the same document.
      match /fastingHistory/{fastId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /bodyScans/{scanId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false; // scans are write-once history, same as formSessions
      }

      // NEW: standalone weight log entries (store/weightLogStore.js),
      // separate from bodyScans - a scan captures weight incidentally as
      // one input among many, but this is the "just log today's weight"
      // flow, meant to be used far more often than a full scan. Same
      // write-once convention as bodyScans/formSessions: correct a bad
      // entry by deleting it, not editing history in place.
      match /weightLogs/{logId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // CRITICAL FIX, same root cause as the data/{docId} fix above:
      // store/workoutStore.js's addWorkout/updateWorkout/deleteWorkout
      // write to users/{uid}/workoutTemplates/{id}, which had no rule of
      // its own - every write here has been silently denied since this
      // path was introduced, for BOTH the original manual "Create
      // Workout" flow and the new AI-generated "Quick Workout" flow
      // (confirmed directly: Quick Workout's first live test failed with
      // exactly this permission error). Mutable like recipes (editing/
      // deleting a saved template is real, expected usage), not
      // write-once like bodyScans/formSessions.
      match /workoutTemplates/{templateId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /challengeJoins/{challengeId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      match /groupMemberships/{groupId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // Who you follow, and which of them are Close Friends. Private to you.
      match /following/{otherUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // People you have blocked (store/blockStore.js): one document per blocked person, named by their uid, holding only what the Blocked
      // people list in Settings shows (their name and picture, and when). Private to you, so the person you blocked is not told. Their
      // posts and comments are hidden from you in the app, and blockedBetween (above) makes the conversation and message rules refuse
      // anything between the two of you, whichever of you blocked. You cannot block yourself.
      match /blocks/{blockedUid} {
        function validBlock() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'avatar', 'blockedAt']) && d.keys().hasAll(['blockedAt']) &&
            (!('name' in d) || (d.name is string && d.name.size() <= 100)) &&
            (!('avatar' in d) || d.avatar == null || (d.avatar is string && d.avatar.size() <= 2000)) &&
            d.blockedAt is string && d.blockedAt.size() <= 40;
        }

        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId && blockedUid != userId && validBlock();
      }
    }

    match /workouts/{workoutId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Real, confirmed fix: loggedSets had no rule at all anywhere in this
    // file - the same silent-denial failure mode already documented
    // above for users/{userId}/data/{docId}. Every write from
    // store/workoutStore.js's logSet, and every read from
    // getExerciseHistory (which services/progressiveOverloadService.js's
    // adaptive prescriptions directly depend on), was very likely being
    // silently denied. Same proven pattern as workouts directly above.
    match /loggedSets/{setId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Real, new: for services/coachService.js's persistent coach chat
    // history (app/coach.jsx) - no update/delete, since a coaching
    // conversation is an append-only log, matching how nothing else here
    // needs to edit a past chat message once sent.
    match /coachMessages/{messageId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /goals/{goalId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /aiRecommendations/{recId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // NEW: store/leaderboardStore.js — genuinely different access pattern
    // from everything above. Every authenticated user can READ every
    // entry (that's the whole point of a leaderboard), but each user can
    // only ever write their own document, keyed by uid.
    //
    // And even their own entry only for who they are: the name and picture. XP, level, streak and distance are NOT the app's to
    // write. They are worked out by the XP ledger (functions/src/xpLedger.js) from claims the app files under
    // users/{uid}/xpClaims, and written here by the function (which is not held to these rules). So nobody can put a score they
    // did not earn on the board, whatever requests they send. An entry may be deleted (hiding from the leaderboards) and made
    // again; the function fills the scores back in when it is (onLeaderboardEntryCreated). An entry written by an older version
    // of the app, with scores already on it, can still be updated for the name and picture.
    match /leaderboard/{uid} {
      function knownKeys() {
        return ['name', 'avatar', 'updatedAt'];
      }

      function validValues() {
        let d = request.resource.data;
        return (!('name' in d) || (d.name is string && d.name.size() <= 100)) &&
          (!('avatar' in d) || d.avatar == null || (d.avatar is string && d.avatar.size() <= 2000)) &&
          (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 40));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(knownKeys()) && validValues();
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(knownKeys()) && validValues();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // NEW: store/communityStore.js — a real public feed. Any authenticated
    // user can read every post; only the author can create their own post
    // (enforced against request.resource.data.authorId, not just trusting
    // the client) or edit/delete it afterward.
    //
    // A post is held to limits: the text is at most 2000 characters, the name at most 100 and the picture address at most 2000, and
    // the name and picture on it must be the ones on the author's profile (publicName and publicImage, above).
    //
    // The like, comment and share counts are not the app's to write at all. A person's like is a document under the post named by
    // their uid (so a double tap is one like), a comment is a document, a share is a document named by the uid, and the functions in
    // functions/src/postCounters.js keep the three counts equal to them. A new post must start at 0, and nobody can change a count
    // afterwards, the author included. All the author can change on a post is its text, the time it was edited and the three
    // settings (hide likes, hide shares, turn comments off); no one else can change a post.
    match /communityPosts/{postId} {
      function validNewPost(uid) {
        let d = request.resource.data;
        return d.text is string && d.text.size() <= 2000 &&
          d.authorName is string && d.authorName.size() <= 100 && d.authorName == publicName(uid) &&
          (d.get('authorAvatar', null) == null || (d.authorAvatar is string && d.authorAvatar.size() <= 2000)) &&
          d.get('authorAvatar', null) == publicImage(uid) &&
          d.likeCount == 0 && d.commentCount == 0 && d.shareCount == 0;
      }

      function validPostEdit() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['text', 'editedAt', 'likesHidden', 'shareCountHidden', 'commentsDisabled']) &&
          (!changed.hasAny(['text']) || (request.resource.data.text is string && request.resource.data.text.size() <= 2000));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId &&
        validNewPost(request.auth.uid);
      allow update: if request.auth != null && request.auth.uid == resource.data.authorId && validPostEdit();
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }

      // The mark that a person shared the post: one document per person, so the share count is the number of people who shared it.
      // Written once and never changed or taken back; only its owner can read it.
      match /shares/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['sharedAt']);
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        function validNewComment(uid) {
          let d = request.resource.data;
          return d.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt']) &&
            d.text is string && d.text.size() <= 1000 &&
            d.authorName is string && d.authorName.size() <= 100 && d.authorName == publicName(uid);
        }

        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId &&
          validNewComment(request.auth.uid) &&
          get(/databases/$(database)/documents/communityPosts/$(postId)).data.get('commentsDisabled', false) != true;
        // A comment can be removed by whoever wrote it, by an admin, and by the owner of the post it is on.
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          request.auth.uid == get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId
        );
      }
    }

    // NEW: store/messagingStore.js — a conversation is only ever readable
    // or writable by its two participants. participantIds is set once at
    // creation (sorted uids, see getConversationId) and never changes, so
    // checking membership against it is safe for both read and update. The
    // rules hold it to that: a conversation can only be created with exactly
    // two ids, in order, under the id those two make (so nobody can claim
    // the id of a pair they are not in), and an update cannot change the list.
    //
    // A message is at most 2000 characters, and so is the copy of the last one kept on the conversation (lastMessage). The name and
    // picture a person puts for themselves in participantInfo must be the ones on their profile (publicName and publicImage, above);
    // the entry for the other person is not checked, because it is only ever shown back to the person who wrote it.
    match /conversations/{conversationId} {
      function lastMessageOk() {
        let last = request.resource.data.lastMessage;
        return last is map && last.get('text', '') is string && last.get('text', '').size() <= 2000;
      }

      function ownInfoMatches() {
        let uid = request.auth.uid;
        let d = request.resource.data;
        return !('participantInfo' in d) || !(uid in d.participantInfo) ||
          (d.participantInfo[uid].get('name', '') == publicName(uid) && d.participantInfo[uid].get('avatar', null) == publicImage(uid));
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds[0] < request.resource.data.participantIds[1] &&
        conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1] &&
        !blockedBetween(request.resource.data.participantIds[0], request.resource.data.participantIds[1]) &&
        (!('lastMessage' in request.resource.data) || lastMessageOk()) &&
        ownInfoMatches();
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds &&
        !blockedBetween(resource.data.participantIds[0], resource.data.participantIds[1]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage']) || lastMessageOk()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantInfo']) || ownInfoMatches());

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt']) &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          !conversationBlocked(conversationId);
      }
    }

    // Reports of a post, a comment or a message (services/reportService.js). The app can only add one: nobody can read, change or delete
    // a report from a phone, the person who made it included. They are read in the Firebase console. The id is
    // `<reporter>_<kind>_<id of the thing>`, so one person reports one thing once (reporting it again is an update, which is refused)
    // and cannot use another person's report id. targetPath is where the thing is in the database, so it can be found there, and text is
    // a copy of what it said, kept in case it is deleted before the report is read.
    match /reports/{reportId} {
      function validReport(id) {
        let d = request.resource.data;
        return d.keys().hasOnly(['reporterId', 'kind', 'targetId', 'targetPath', 'targetAuthorId', 'reason', 'text', 'createdAt']) &&
          d.keys().hasAll(['reporterId', 'kind', 'targetId', 'targetPath', 'targetAuthorId', 'reason', 'createdAt']) &&
          d.reporterId == request.auth.uid &&
          d.kind in ['post', 'comment', 'message'] &&
          d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 128 &&
          id == d.reporterId + '_' + d.kind + '_' + d.targetId &&
          d.targetPath is string && d.targetPath.size() <= 300 &&
          d.targetAuthorId is string && d.targetAuthorId.size() <= 128 &&
          d.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'self_harm', 'other'] &&
          (!('text' in d) || (d.text is string && d.text.size() <= 1000)) &&
          d.createdAt is string && d.createdAt.size() <= 40;
      }

      allow read, update, delete: if false;
      allow create: if request.auth != null && validReport(reportId);
    }

    // NEW: admin console (see admin/ — a separate web app, not part of
    // the mobile bundle). Deliberately has NO client-writable path at
    // all — granting admin access only ever happens via the Firebase
    // Console or Admin SDK directly, never through any code a user's
    // device could run. Every authenticated user can READ this
    // collection (needed so the admin console's own login check can ask
    // "is this uid an admin"), but that read only ever returns a
    // document for uids that already have one — it can't be used to
    // grant yourself access.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Content catalogs the admin console manages. Readable by any
    // authenticated user (the mobile app needs this), writable only by a
    // real, verified admin — checked by looking up the /admins/{uid}
    // document for the requester, not a client-supplied claim.
    match /runningPrograms/{programId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A person's plan: Free, Pro or Legend (lib/entitlements.js). The person can read their own and nobody can write it from the app,
    // an admin included, so nobody can give themselves a plan. It is written from the Firebase console and, once purchases are
    // connected, by the function that hears from RevenueCat.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // How many AI messages each person has used today (functions/src/aiQuota.js), one document per person per day. Only the
    // functions read and write it, so the count cannot be reset or read from a phone.
    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public progress board for challenges. Anyone signed in can read; each
    // person can only create, change or remove their OWN entry (the document
    // id must be `<challengeId>_<uid>`).
    match /challengeEntries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        entryId == request.resource.data.challengeId + '_' + request.auth.uid;
      allow delete: if request.auth != null && entryId.matches('.*_' + request.auth.uid);
    }

    // Public boards for the virtual races (the Local 5K every week, the Worldwide
    // 10K every month). Anyone signed in can read. Each person can only write their
    // OWN result (the document id must be `<raceId>_<uid>`), it must be a time a
    // person could run (between 2:20 and 30:00 a kilometre), the local race carries
    // only a coarse map square (never a position), and a result already there can
    // only be replaced by a faster one.
    match /raceEntries/{entryId} {
      function validRaceEntry() {
        let d = request.resource.data;
        return request.auth != null &&
          d.keys().hasOnly(['raceId', 'uid', 'kind', 'distanceKm', 'name', 'avatar', 'timeSec', 'finishedAt', 'areaId']) &&
          d.keys().hasAll(['raceId', 'uid', 'kind', 'distanceKm', 'name', 'avatar', 'timeSec', 'finishedAt', 'areaId']) &&
          d.uid == request.auth.uid &&
          d.raceId is string &&
          entryId == d.raceId + '_' + request.auth.uid &&
          ((d.kind == 'local' && d.distanceKm == 5 &&
              d.raceId.matches('^local-5k-week-[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
              d.areaId is string && d.areaId.size() > 0 && d.areaId.size() <= 12) ||
           (d.kind == 'world' && d.distanceKm == 10 &&
              d.raceId.matches('^world-10k-month-[0-9]{4}-[0-9]{2}$') &&
              d.areaId == null)) &&
          d.timeSec is int &&
          d.timeSec >= d.distanceKm * 140 &&
          d.timeSec <= d.distanceKm * 1800 &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 40 &&
          (d.avatar == null || (d.avatar is string && d.avatar.size() <= 600)) &&
          d.finishedAt is string && d.finishedAt.size() <= 40;
      }

      allow read: if request.auth != null;
      allow create: if validRaceEntry();
      allow update: if validRaceEntry() && request.resource.data.timeSec < resource.data.timeSec;
      allow delete: if request.auth != null && entryId.matches('.*_' + request.auth.uid);
    }

    // A duel is proposed by one of its two people (`proposedBy`, which must be the person creating it) and only the OTHER
    // person can accept it. Either of them can decline it (the proposer withdrawing it counts as declining).
    match /duels/{duelId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.proposedBy == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'declined' ||
          (request.resource.data.status == 'active' &&
            resource.data.get('proposedBy', null) in resource.data.participantIds &&
            resource.data.proposedBy != request.auth.uid));

      allow delete: if false;
    }

    // Calendar invites (lib/calendarInvites.js, store/calendarInviteStore.js): a copy of one of the sender's calendar events, offered to
    // one other person. Only its two people can read it. The sender creates it, as pending, naming themselves as `fromUid`, and only for
    // someone they follow (their own follow list, users/{uid}/following/{otherUid}, which only they can read or write). Once it is
    // there, only the status and the time of the answer can change, and only while it is pending: the person invited can accept or
    // decline it, and the sender can cancel it. Nothing is ever deleted, and an answered invite never changes again.
    match /calendarInvites/{inviteId} {
      function inviteKeys() {
        return ['participantIds', 'fromUid', 'toUid', 'fromName', 'toName', 'status', 'eventId', 'title', 'kind', 'start', 'notes', 'repeat', 'createdAt'];
      }
      function validInvite() {
        let d = request.resource.data;
        return d.keys().hasOnly(inviteKeys()) && d.keys().hasAll(inviteKeys()) &&
          d.fromUid == request.auth.uid &&
          d.toUid is string && d.toUid.size() > 0 && d.toUid != d.fromUid &&
          d.participantIds is list && d.participantIds.size() == 2 &&
          d.participantIds.hasAll([d.fromUid, d.toUid]) &&
          d.status == 'pending' &&
          d.fromName is string && d.fromName.size() <= 60 &&
          d.toName is string && d.toName.size() <= 60 &&
          d.eventId is string && d.eventId.size() <= 120 &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 80 &&
          d.kind in ['workout', 'run', 'nutrition', 'other'] &&
          d.start is string && d.start.size() <= 40 &&
          d.notes is string && d.notes.size() <= 500 &&
          (d.repeat == null || d.repeat is map) &&
          d.createdAt is string && d.createdAt.size() <= 40;
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;

      allow create: if request.auth != null && validInvite() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(request.resource.data.toUid));

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participantIds &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
        request.resource.data.respondedAt is string && request.resource.data.respondedAt.size() <= 40 &&
        ((request.auth.uid == resource.data.toUid && request.resource.data.status in ['accepted', 'declined']) ||
          (request.auth.uid == resource.data.fromUid && request.resource.data.status == 'cancelled'));

      allow delete: if false;
    }

    match /communityGroups/{groupId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      // Only an admin changes a group. The member count is not written from the app at all: the onGroupJoined and onGroupLeft
      // functions (expo/functions/src/groupMemberCount.js) move it whenever a users/{uid}/groupMemberships document appears or goes.
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
