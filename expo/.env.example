# ─────────────────────────────────────────────────────────────
#  Zown HQ Fitness App — Environment Variables
#  Copy this file to .env and fill in the values.
#  .env is git-ignored. Never put a real key in this file: it is committed.
#  Production values live in EAS (eas env:list production).
#  Expo SDK 54 | Bundle: com.zownhq.app
# ─────────────────────────────────────────────────────────────

# ─── Firebase (zown-3c512) ────────────────────────────────────
# Firebase Console → Project settings → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=zown-3c512.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=zown-3c512
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=zown-3c512.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=431690627943
# iOS App ID  ↓
EXPO_PUBLIC_FIREBASE_APP_ID=1:431690627943:ios:452de869042bbce299cdc2
# Android App ID (update if you add an Android app in Firebase Console)
# EXPO_PUBLIC_FIREBASE_APP_ID=1:431690627943:android:db8f94e7c16be73299cdc2
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Spotify ─────────────────────────────────────────────────
# The client ID is public. The client SECRET never goes in the app or in this
# file: it lives in Firebase Secret Manager (see the OpenAI section below).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
# Production redirect URI (registered in Spotify Dashboard)
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=zownhq://spotify-callback
# Expo Go dev proxy URI — also register this in Spotify Dashboard:
# https://auth.expo.io/@cwright2255/zown-hq

# ─── ROOK Wearables SDK ───────────────────────────────────────
# The ROOK client UUID and secret live in Firebase Secret Manager, not here.
# Use "sandbox" until Production credentials are set up at clients.portal.tryrook.io
EXPO_PUBLIC_ROOK_ENVIRONMENT=sandbox

# ─── Radar (geocoding / routing) ─────────────────────────────
# Publishable key from the https://radar.com dashboard (test key for development)
EXPO_PUBLIC_RADAR_PUBLISHABLE_KEY=your-radar-publishable-key

# ─── Hiking ──────────────────────────────────────────────────
# TrailAPI is a RapidAPI product: this is the X-RapidAPI-Key for it.
EXPO_PUBLIC_TRAILAPI_KEY=your-rapidapi-key-for-trailapi
# Google Cloud Console → "Places API (New)". Restrict the key to the iOS bundle
# ID com.zownhq.app (and the Places API only).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-key

# ─── RapidAPI (muscle visualizer) ────────────────────────────
EXPO_PUBLIC_RAPIDAPI_KEY=your-rapidapi-key

# ─── Firebase Cloud Functions base URL ───────────────────────
# Override to target an emulator or alternate region
EXPO_PUBLIC_API_BASE_URL=

# ─── Server-side only — DO NOT put these in the client app ───
# Set each one with Firebase Secret Manager, for example:
#   firebase functions:secrets:set OPENAI_API_KEY
#   firebase functions:secrets:set SPOTIFY_CLIENT_ID
#   firebase functions:secrets:set SPOTIFY_CLIENT_SECRET
#   firebase functions:secrets:set ROOK_CLIENT_UUID
#   firebase functions:secrets:set ROOK_CLIENT_SECRET
#   firebase functions:secrets:set CALORIE_API_KEY
#   firebase functions:secrets:set SPOONACULAR_API_KEY
#   firebase functions:secrets:set RAPIDAPI_KEY
#   firebase functions:secrets:set RADAR_LIVE_SECRET_KEY
#   firebase functions:secrets:set RADAR_TEST_SECRET_KEY
