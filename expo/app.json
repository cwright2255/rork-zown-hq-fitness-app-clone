{
  "expo": {
    "name": "ZOWN HQ",
    "slug": "zown-hq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/zown-logo-512.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/zown-logo-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zownhq.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "ZOWN HQ needs camera access to capture body scan photos for AI body composition analysis.",
        "NSPhotoLibraryUsageDescription": "ZOWN HQ needs photo library access to upload body scan photos and profile avatars.",
        "NSHealthShareUsageDescription": "ZOWN HQ needs access to sync workouts, steps, heart rate, and sleep data with Apple Health.",
        "NSHealthUpdateUsageDescription": "ZOWN HQ needs access to save completed workouts and health metrics to Apple Health.",
        "NSAppleMusicUsageDescription": "ZOWN HQ needs access to Apple Music to play your music during workouts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "appleTeamId": "GLFKG8342N"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/zown-logo-512.png",
        "backgroundColor": "#000000"
      },
      "package": "com.zownhq.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "zownhq"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/branding/zown-logo-512.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ZOWN HQ uses your location to track and map your runs and walks.",
          "locationAlwaysAndWhenInUsePermission": "ZOWN HQ uses your location to keep recording your run while the screen is locked or the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-apple-authentication",
      ["@react-native-firebase/app", { "ios": { "disableSPM": true } }],
      "@react-native-firebase/crashlytics",
      "./plugins/withPoseModel.js",
      "./plugins/withPoseDetectorErrorPatch.js",
      "./plugins/withPoseDetectionThreadingPatch.js",
      "./plugins/withMediaPipeFrameworkHeaderPatch.js",
      "./plugins/withAllowNonModularIncludes.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkExtension": 19
          },
          "ios": {
            "deploymentTarget": "16.0",
            "useFrameworks": "static",
            "forceStaticLinking": ["RNFBApp", "RNFBCrashlytics"]
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "ZOWN HQ needs access to sync workouts, steps, heart rate, and sleep data with Apple Health.",
          "NSHealthUpdateUsageDescription": "ZOWN HQ needs access to save completed workouts and health metrics to Apple Health.",
          "background": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "97962c67-b686-4470-9dd8-8e874d90b279"
      },
      "last_channel_diagnostic": "2026-07-09T16:21:00Z"
    },
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "zownhq",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97962c67-b686-4470-9dd8-8e874d90b279"
    }
  }
}
