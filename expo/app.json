{
  "expo": {
    "name": "ZOWN HQ",
    "slug": "zown-hq",
    "scheme": "zownhq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/zown-logo-512.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/zown-logo-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zownhq.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ZOWN HQ needs camera access to capture body scan photos for AI body composition analysis.",
        "NSPhotoLibraryUsageDescription": "ZOWN HQ needs photo library access to upload body scan photos and profile avatars.",
        "NSHealthShareUsageDescription": "ZOWN HQ needs access to sync workouts, steps, heart rate, and sleep data with Apple Health.",
        "NSHealthUpdateUsageDescription": "ZOWN HQ needs access to save completed workouts and health metrics to Apple Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      },
      "appleTeamId": "GLFKG8342N"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/zown-logo-512.png",
        "backgroundColor": "#000000"
      },
      "package": "com.zownhq.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "zownhq"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/branding/zown-logo-512.png"
    },
    "plugins": [
      "rnative-body-scan",
      "@corsalites/react-native-keep-awake",
      [
        "expo-build-properties",
        {
          "android": {
            "useAndroidXNativeComponents": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "34.0.0",
            "minSdkVersion": 24,
            "compileSdkExtension": 19
          },
          "ios": {
            "uniqueComponentNames": true
          }
        }
      ],
      [
        "expo-health-connect",
        {
          "updateBackgroundDeliveryMode": "imMEDIATE",
          "intentFilters": [
            "ACTIVITY_RECOGNITION"
          ]
        }
      ],
      "expo-location",
      "expo-camera",
      "healthkit",
      "rnative-rook-health",
      [
        "@expo/vector-icons",
        "fonts"
      ],
      "expo-router"
    ],
    "extra": {
      "facebook": {
        "appId": "1234567890"
      },
      "google": {},
      "rook": {
        "clientId": "zownhq-fitness-app",
        "asyncInit": true
      },
      "weabase": {
        "appId": "zownhq-app"
      },
      "eas": {
        "projectId": "97962c67-b686-4470-9dd8-8e874d90b279"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97962c67-b686-4470-9dd8-8e874d90b279"
    }
  }
}
